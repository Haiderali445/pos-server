# ==============================================================================
# Hardware Point POS — Backend Environment Variables
# ==============================================================================

# Port the Express HTTP Server will listen on (Default: 8080)
PORT=8080

# MongoDB Connection String (MongoDB Atlas SRV or Local standalone/replica set)
# Note: Atlas SRV records are resolved automatically with DNS fallbacks in config.js
MONGOS_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pos-mern?retryWrites=true&w=majority

# Secret key used by JoseTokenSigner to sign and verify JSON Web Tokens
JWT_SECRET=super-secret-pos-production-key-change-this

# Token validity duration (e.g. 8h, 24h, 7d)
JWT_EXPIRES_IN=8h
